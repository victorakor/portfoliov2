# Victor Akor Portfolio v3 — production environment (Oracle Cloud VM)
# Copy to .env on the server and fill in. Never commit the real .env.
#
#   cp .env.production.example .env && nano .env
#
# Note: DATABASE_URL is NOT set here — docker-compose.yml builds it from
# DB_PASSWORD and points the app at the postgres service.

# Public hostname, no scheme, no trailing slash. Caddy requests the TLS
# certificate for exactly this name, and it also becomes ALLOWED_ORIGIN.
DOMAIN=victorakor.com

# Postgres password for the bundled database.
#   openssl rand -base64 24
DB_PASSWORD=

# Must be at least 32 characters. Changing it invalidates all admin sessions.
#   openssl rand -base64 48
JWT_SECRET=

# Email (Resend). RESEND_FROM must be on a domain verified for sending in
# Resend, otherwise sends fail with 403. LEAD_NOTIFY_TO receives contact-form
# notifications; it defaults to the owner address baked into internal/email.
RESEND_API_KEY=
RESEND_FROM=
LEAD_NOTIFY_TO=

# Storage (Cloudinary) — used by POST /api/admin/upload
CLOUDINARY_URL=

# Analytics. Not read by any Go code; the gtag snippet is hardcoded in
# templates/public/*.html. Kept for reference only.
GA_MEASUREMENT_ID=

# AI assistant. Ollama Cloud key from ollama.com.
OLLAMA_API_KEY=

# Optional override. Leave blank to use the code default, gpt-oss:120b.
OLLAMA_MODEL=
