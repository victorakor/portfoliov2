# Victor Akor Portfolio v3 — reverse proxy + automatic HTTPS
# DOMAIN is injected by docker-compose.yml. Caddy provisions and renews the
# Let's Encrypt certificate on its own; there is no certbot step.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
}

# Send the apex/www variant to the canonical host. Delete this block if you
# only pointed one name at the server.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

