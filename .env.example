# Victor Akor Portfolio v3 — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8080
ENV=development

# Database (use DATABASE_URL for Railway, or individual vars for local)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=portfolio
DB_SSLMODE=disable

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Storage (Cloudinary)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AI Assistant (Ollama Cloud — ollama.com)
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_MODEL=gpt-oss:120b

# CORS
ALLOWED_ORIGIN=https://yourdomain.com
