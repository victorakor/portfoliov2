# Victor Akor Portfolio v3 — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8080
ENV=development

# Database (use DATABASE_URL for Railway, or individual vars for local)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=portfolio
DB_SSLMODE=disable

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
# Sender. Must be on a domain verified for sending in Resend, or sends fail 403.
RESEND_FROM=Portfolio <portfolio@yourdomain.com>
# Where contact-form notifications are delivered.
LEAD_NOTIFY_TO=you@example.com

# Storage (Cloudinary) — used by POST /api/admin/upload
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Analytics. Not read by any Go code — the gtag snippet is hardcoded in
# templates/public/*.html. Kept for reference only.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AI Assistant (Ollama Cloud — ollama.com)
OLLAMA_API_KEY=your_ollama_cloud_api_key
OLLAMA_MODEL=gpt-oss:120b

# CORS
ALLOWED_ORIGIN=https://yourdomain.com
